# Anthropic API key — used by lib/analyzeStocks.ts to call Claude.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Finnhub API key — used for US stock quotes (NVDA, TSLA, GME etc).
# Free tier covers 60 req/min, but international markets are paid only.
# Sign up at https://finnhub.io/
FINNHUB_API_KEY=

# Stockholm tickers fetch from Avanza's unofficial public JSON API
# (https://www.avanza.se/_api/market-guide/stock/{orderbookId}) — no
# auth, no key, no signup. The orderbookId for each ticker is hardcoded
# in lib/tickers.ts.

# Shared secret guarding /api/trigger. Send via the `x-trigger-secret`
# header (preferred) or `?key=...` query param (legacy — query strings
# leak into Vercel access logs and Referer headers, so prefer the
# header for any new integration). Pick something long and random,
# e.g. `openssl rand -hex 32`.
TRIGGER_SECRET=

# Vercel Cron auth. Set this in Vercel only (Production scope) — Vercel
# automatically signs cron requests with `Authorization: Bearer
# ${CRON_SECRET}` and the trigger route accepts that header. Local dev
# doesn't fire crons, so no local value needed. Generate the same way:
# `openssl rand -hex 32`.
CRON_SECRET=

# Upstash Redis REST endpoint and token.
# In production these are auto-injected when you install the Upstash Redis
# integration from Vercel Marketplace and connect it to the project. For
# local dev, copy them from Vercel dashboard → Storage → your Upstash
# database → ".env.local" tab.
#
# The legacy KV_REST_API_URL / KV_REST_API_TOKEN names also work — the
# storage layer reads either set.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Local dev only — forces /api/data to return a hardcoded fixture
# instead of hitting KV. In non-production builds the app already
# auto-falls-back to mock data when KV creds are absent, so you only
# need this to override that behavior (e.g. force mock even with KV
# configured). Leave blank or unset in production.
USE_MOCK_DATA=

# Local dev only — preview different dashboard states by adding a
# `?mode=X` query param to the URL (replaces the older
# MOCK_BRIEF_LATEST env var, which is no longer read):
#
#   http://localhost:4242/                   → default Tuesday afternoon
#   http://localhost:4242/?mode=weekend      → Sat/Sun: weekend wire pinned
#   http://localhost:4242/?mode=morning      → morning wire pinned
#   http://localhost:4242/?mode=evening      → evening wrap pinned
#   http://localhost:4242/?mode=fresh        → first-deploy: no WTD column,
#                                              no champion-of-week card
#   http://localhost:4242/?mode=empty        → "NO DATA YET" empty state
#
# Only takes effect in mock mode (no Redis configured, or
# USE_MOCK_DATA=true). Production ignores the param entirely.

# Public canonical URL — used as metadataBase for OG/Twitter card
# absolute URLs. Set to https://iskbets.se in production. Falls back
# to https://${VERCEL_URL} for preview deploys, and localhost in dev.
NEXT_PUBLIC_SITE_URL=
