# Anthropic API key — used by lib/analyzeStocks.ts to call Claude.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Shared secret guarding /api/trigger. Required as ?key=... query param.
# Pick something long and random, e.g. `openssl rand -hex 32`.
TRIGGER_SECRET=

# Vercel KV (Upstash Redis) REST endpoint and token.
# In production these are auto-injected when you connect a KV store to the
# project on Vercel. For local dev, copy them from Vercel dashboard →
# Storage → your KV store → ".env.local" tab.
KV_REST_API_URL=
KV_REST_API_TOKEN=
